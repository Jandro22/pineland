{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pineland.local/schemas/comparative-case-contract-1.0.0.json",
  "title": "Pineland comparative case contract",
  "type": "object",
  "required": [
    "schema_version", "case_id", "role", "status", "period", "construct_map",
    "inputs", "observables", "holdouts", "disabled_mechanisms",
    "case_input_uncertainty", "calibration"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "status": {"enum": ["preregistered", "data_construction", "ready", "running", "complete", "falsified"]},
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "construct_map": {"type": "array", "minItems": 1},
    "inputs": {"type": "array", "minItems": 1},
    "observables": {"type": "array", "minItems": 2},
    "holdouts": {"type": "object", "required": ["temporal", "geographic", "joint", "outcome_blind_selection"]},
    "disabled_mechanisms": {"type": "array"},
    "case_input_uncertainty": {"type": "array", "minItems": 1},
    "calibration": {
      "type": "object",
      "required": ["licensed", "training_only", "holdout_refit"],
      "properties": {
        "licensed": {"const": false},
        "training_only": {"const": true},
        "holdout_refit": {"const": false}
      }
    }
  }
}
