{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PartnerForceAutonomyOutputSchema",
  "description": "Schema for simulation outputs and paired counterfactual evaluations in the Pineland Partner-Force Autonomy Experiment.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "pair_id",
    "architecture",
    "seed",
    "withdrawal_time_ticks",
    "horizon_days",
    "branch",
    "supported_performance",
    "organic_capacity",
    "counterfactual_metrics",
    "donor_costs",
    "regenerative_coordinates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pineland.partner_force_autonomy_output.v1"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the single branch simulation run."
    },
    "pair_id": {
      "type": "string",
      "description": "Identifier linking the matched SUPPORT_ON and SUPPORT_OFF runs."
    },
    "architecture": {
      "type": "string",
      "enum": [
        "substitution_heavy",
        "capacity_heavy",
        "bottleneck_targeted",
        "calendar_transition",
        "capability_conditioned"
      ]
    },
    "seed": {
      "type": "integer",
      "description": "PRNG initialization seed."
    },
    "withdrawal_time_ticks": {
      "type": "integer",
      "minimum": 0,
      "description": "Step tick T at which withdrawal occurs on the OFF branch."
    },
    "horizon_days": {
      "type": "integer",
      "enum": [7, 30, 90, 180],
      "description": "Post-withdrawal measurement horizon h."
    },
    "branch": {
      "type": "string",
      "enum": ["SUPPORT_ON", "SUPPORT_OFF"]
    },
    "supported_performance": {
      "type": "object",
      "required": [
        "territorial_retention",
        "formation_survival_fraction",
        "casualty_ratio",
        "mean_formation_readiness",
        "composite_capability"
      ],
      "properties": {
        "territorial_retention": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "formation_survival_fraction": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "casualty_ratio": { "type": "number", "minimum": 0.0 },
        "mean_formation_readiness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "composite_capability": { "type": "number", "minimum": 0.0 }
      }
    },
    "organic_capacity": {
      "type": "object",
      "required": [
        "organic_personnel_reserve",
        "recruit_graduation_throughput",
        "indigenous_supply_delivered",
        "unassisted_command_reliability"
      ],
      "properties": {
        "organic_personnel_reserve": { "type": "number", "minimum": 0.0 },
        "recruit_graduation_throughput": { "type": "number", "minimum": 0.0 },
        "indigenous_supply_delivered": { "type": "number", "minimum": 0.0 },
        "unassisted_command_reliability": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "counterfactual_metrics": {
      "type": "object",
      "required": [
        "autonomy_ratio",
        "performance_delta",
        "substitution_index",
        "decay_rate"
      ],
      "properties": {
        "autonomy_ratio": {
          "type": "number",
          "minimum": 0.0,
          "description": "R_h = C_OFF(T+h) / max(C_ON(T+h), epsilon)"
        },
        "performance_delta": {
          "type": "number",
          "description": "Delta_h = C_ON(T+h) - C_OFF(T+h)"
        },
        "substitution_index": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Fraction of total pre-withdrawal capability derived from external assistance."
        },
        "decay_rate": {
          "type": "number",
          "description": "Exponential decay constant lambda where C(T+h) = C(T) * exp(-lambda * h)."
        }
      }
    },
    "donor_costs": {
      "type": "object",
      "required": [
        "air_cost",
        "logistics_cost",
        "command_cost",
        "force_gen_cost",
        "total_cost",
        "discounted_cost"
      ],
      "properties": {
        "air_cost": { "type": "number", "minimum": 0.0 },
        "logistics_cost": { "type": "number", "minimum": 0.0 },
        "command_cost": { "type": "number", "minimum": 0.0 },
        "force_gen_cost": { "type": "number", "minimum": 0.0 },
        "total_cost": { "type": "number", "minimum": 0.0 },
        "discounted_cost": { "type": "number", "minimum": 0.0 }
      }
    },
    "regenerative_coordinates": {
      "type": "object",
      "required": [
        "omega_manpower",
        "omega_firepower",
        "omega_logistics",
        "omega_command",
        "omega_min",
        "omega_mean",
        "omega_geo"
      ],
      "properties": {
        "omega_manpower": { "type": "number", "minimum": 0.0 },
        "omega_firepower": { "type": "number", "minimum": 0.0 },
        "omega_logistics": { "type": "number", "minimum": 0.0 },
        "omega_command": { "type": "number", "minimum": 0.0 },
        "omega_min": { "type": "number", "minimum": 0.0 },
        "omega_mean": { "type": "number", "minimum": 0.0 },
        "omega_geo": { "type": "number", "minimum": 0.0 }
      }
    }
  }
}
