    "local_monolithic_fallback": "cargo run --release --manifest-path rust/Cargo.toml -p pineland-model --example partner_force_autonomy_stage3 -- --execute --output studies/research_program/general_theory_v1/partner_force_autonomy/outputs/partner_force_autonomy_stage3_raw_v3.csv --trajectory-output studies/research_program/general_theory_v1/partner_force_autonomy/outputs/partner_force_autonomy_stage3_trajectory_v2.csv",
    "analyze_and_freeze_stage3": "python studies/research_program/general_theory_v1/partner_force_autonomy/analysis/evaluate_partner_force_autonomy.py --input-csv studies/research_program/general_theory_v1/partner_force_autonomy/outputs/partner_force_autonomy_stage3_raw_v3.csv --freeze-predictor-json studies/research_program/general_theory_v1/partner_force_autonomy/outputs/partner_force_autonomy_frozen_predictor_v1.json",
    "arc_holdout_pattern": "sbatch --array=0-95%8 --export=ALL,PF_MODE=holdout,PF_HOLDOUT_CONTRACT=<frozen-contract>,PF_OUTPUT_DIR=<family-shard-dir> studies/research_program/general_theory_v1/partner_force_autonomy/arc/partner_force_array.sbatch",
    "analyze_stage3_trajectories_diagnostic_only": "python studies/research_program/general_theory_v1/partner_force_autonomy/analysis/analyze_partner_force_trajectories.py --trajectory-csv studies/research_program/general_theory_v1/partner_force_autonomy/outputs/partner_force_autonomy_stage3_trajectory_v2.csv --output-dir studies/research_program/general_theory_v1/partner_force_autonomy/outputs/trajectory_diagnostics"
  },
  "safety": {
