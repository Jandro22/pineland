      "unit": "municipality-year"
    },
    {
      "construct": "civilian_harm",
      "measurement_model": "victim/event counts with modality-specific missingness and source uncertainty",
      "source": "CNMH Observatorio de Memoria y Conflicto, https://micrositios.centrodememoriahistorica.gov.co/observatorio/portal-de-datos/base-de-datos/",
      "unit": "municipality-month"
    }
  ],
